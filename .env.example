# Banco de dados (SQLite local — não precisa instalar nada)
DATABASE_URL="file:./dev.db"

# Gere um valor aleatório com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# API key gratuita do TMDB (The Movie Database)
# Crie a sua em https://www.themoviedb.org/settings/api
TMDB_API_KEY="sua-api-key-v3-aqui"
